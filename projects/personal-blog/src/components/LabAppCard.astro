---
import type { LabApp } from "../config/hub";

interface Props {
  app: LabApp;
  compact?: boolean;
}

const { app, compact = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}${app.href.replace(/^\//, "")}`;

const statusLabel = {
  live: "可使用",
  beta: "Beta",
  planned: "规划中"
}[app.status];
---

<article class={`app-card${compact ? " app-card--compact" : ""}`}>
  <div class="app-card__header">
    <div>
      <p class="eyebrow">{app.category}</p>
      <h3>
        <a href={href}>{app.title}</a>
      </h3>
    </div>
    <span class={`status-badge status-badge--${app.status}`}>{statusLabel}</span>
  </div>

  <p class="app-card__tagline">{app.tagline}</p>
  <p class="app-card__description">{app.description}</p>

  <dl class="app-meta">
    <div>
      <dt>体验时长</dt>
      <dd>{app.estimatedTime}</dd>
    </div>
    <div>
      <dt>输入信息</dt>
      <dd>{app.inputs.length} 类</dd>
    </div>
  </dl>

  <div class="app-card__chips">
    {app.highlights.map((item) => (
      <span class="chip">{item}</span>
    ))}
  </div>

  {!compact && (
    <ul class="app-points">
      {app.useCases.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  )}

  <p class="app-card__footer">
    <a href={href}>打开项目 →</a>
  </p>
</article>
