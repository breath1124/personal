---
import type { Channel } from "../config/hub";

interface Props {
  channel: Channel;
}

const { channel } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}${channel.href.replace(/^\//, "")}`;
---

<a class={`portal-card portal-card--${channel.slug}`} href={href}>
  <div class="portal-card__top">
    <p class="eyebrow">{channel.eyebrow}</p>
    <h2>{channel.title}</h2>
    <p class="portal-card__description">{channel.description}</p>
  </div>

  <div class="portal-card__bottom">
    <div class="portal-card__chips">
      {channel.highlights.map((item) => (
        <span class="portal-chip">{item}</span>
      ))}
    </div>
    <span class="portal-card__cta">{channel.ctaLabel} →</span>
  </div>
</a>
