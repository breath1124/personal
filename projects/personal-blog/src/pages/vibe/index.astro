---
import BaseLayout from "../../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="实验室跳转" description="正在进入新的实验室应用" noindex>
  <section class="hero">
    <h1>正在进入实验室</h1>
    <p>新的交互应用已经迁移到独立的 Lab 区域。</p>
    <p style="margin-top: 1rem">
      <a href={`${base}lab/`}>如果没有自动跳转，点这里进入 →</a>
    </p>
  </section>
  <script is:inline define:vars={{ target: `${base}lab/` }}>
    window.location.replace(target);
  </script>
</BaseLayout>
