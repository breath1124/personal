---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LAB_APPS } from "../../config/hub";
const base = import.meta.env.BASE_URL;

export function getStaticPaths() {
  return LAB_APPS.map((app) => ({
    params: { slug: app.slug },
    props: { app }
  }));
}

const { app } = Astro.props;
const target = `${base}${app.href.replace(/^\//, "")}`;
---

<BaseLayout title={`${app.title} 跳转`} description="正在进入新的实验室应用" noindex>
  <section class="hero">
    <h1>正在进入 {app.title}</h1>
    <p>这个项目已经迁移到新的 Lab 应用区。</p>
    <p style="margin-top: 1rem">
      <a href={target}>
        如果没有自动跳转，点这里进入 →
      </a>
    </p>
  </section>
  <script is:inline define:vars={{ target }}>
    window.location.replace(target);
  </script>
</BaseLayout>
