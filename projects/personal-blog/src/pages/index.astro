---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import LabAppCard from "../components/LabAppCard.astro";
import PortalCard from "../components/PortalCard.astro";
import { HOME_CHANNELS, LAB_APPS } from "../config/hub";
import { toUrlSlug } from "../utils/slug";
import { getCategories } from "../utils/taxonomy";

const base = import.meta.env.BASE_URL;
const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const posts = allPosts.slice(0, 4);
---

<BaseLayout>
  <section class="hero hero--portal">
    <div class="hero-copy">
      <p class="eyebrow">Changyungo</p>
      <h1>写作与实验并行的个人网站</h1>
      <p>
        一边写长文，一边把想法做成交互界面。这里有适合慢慢读的内容，也有可以直接打开使用的工具。
      </p>
      <div class="hero-actions">
        <a class="hero-button hero-button--primary" href={`${base}blog/`}>
          进入博客
        </a>
        <a class="hero-button" href={`${base}lab/`}>
          打开实验室
        </a>
      </div>
    </div>
  </section>

  <section class="section-block">
    <div class="section-head">
      <div>
        <p class="eyebrow">Two Ways In</p>
        <h2>两个入口，各做一件事</h2>
      </div>
    </div>

    <div class="portal-grid">
      {HOME_CHANNELS.map((channel) => (
        <PortalCard channel={channel} />
      ))}
    </div>
  </section>

  <section class="section-block">
    <div class="section-head">
      <div>
        <p class="eyebrow">Recent Writing</p>
        <h2>最近文章</h2>
      </div>
      <a class="section-link" href={`${base}blog/`}>
        查看全部文章 →
      </a>
    </div>

    <ul class="post-list">
      {
        posts.map((post) => {
          const categories = getCategories(post.data);

          return (
            <li class="post-item">
              <h3>
                <a href={`${base}blog/${post.slug}/`}>{post.data.title}</a>
              </h3>
              <p>{post.data.description}</p>
              {categories.length > 0 && (
                <div class="taxonomy taxonomy--compact">
                  {categories.map((category) => (
                    <a
                      class="chip"
                      href={`${base}categories/${toUrlSlug(category)}/`}
                    >
                      {category}
                    </a>
                  ))}
                </div>
              )}
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="section-block">
    <div class="section-head">
      <div>
        <p class="eyebrow">Lab Picks</p>
        <h2>现在可以直接打开的项目</h2>
      </div>
      <a class="section-link" href={`${base}lab/`}>
        进入实验室 →
      </a>
    </div>

    <div class="app-grid">
      {LAB_APPS.map((app) => (
        <LabAppCard app={app} compact />
      ))}
    </div>
  </section>
</BaseLayout>
