---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import LabAppCard from "../components/LabAppCard.astro";
import PortalCard from "../components/PortalCard.astro";
import { HOME_CHANNELS, LAB_APPS } from "../config/hub";
import { toUrlSlug } from "../utils/slug";
import { getCategories } from "../utils/taxonomy";

const base = import.meta.env.BASE_URL;
const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const posts = allPosts.slice(0, 4);
---

<BaseLayout>
  <section class="hero hero--portal">
    <div class="hero-copy">
      <p class="eyebrow">个人主页入口</p>
      <h1>博客与实验室并行的个人站点</h1>
      <p>
        这里保留长期写作，也放入可以直接打开使用的小工具和界面型项目。你可以从内容进入，也可以从交互入口进入。
      </p>
    </div>

    <div class="metric-strip">
      <div class="metric-card">
        <span>站点定位</span>
        <strong>内容 + 工具</strong>
        <p>不只是一组博客文章，而是持续扩展的个人门户。</p>
      </div>
      <div class="metric-card">
        <span>博客文章</span>
        <strong>{allPosts.length} 篇</strong>
        <p>论文阅读、工程实践与产品思考持续沉淀。</p>
      </div>
      <div class="metric-card">
        <span>实验项目</span>
        <strong>{LAB_APPS.length} 个</strong>
        <p>可直接使用的交互页面，后续会继续增加。</p>
      </div>
    </div>
  </section>

  <section class="section-block">
    <div class="section-head">
      <div>
        <p class="eyebrow">双入口</p>
        <h2>从两个方向进入这个网站</h2>
      </div>
      <p class="section-head__note">一个用于阅读，一个用于直接操作。</p>
    </div>

    <div class="portal-grid">
      {HOME_CHANNELS.map((channel) => (
        <PortalCard channel={channel} />
      ))}
    </div>
  </section>

  <section class="section-block">
    <div class="section-head">
      <div>
        <p class="eyebrow">最新文章</p>
        <h2>继续保留博客这条主线</h2>
      </div>
      <a class="section-link" href={`${base}blog/`}>
        查看全部文章 →
      </a>
    </div>

    <ul class="post-list">
      {
        posts.map((post) => {
          const categories = getCategories(post.data);

          return (
            <li class="post-item">
              <h3>
                <a href={`${base}blog/${post.slug}/`}>{post.data.title}</a>
              </h3>
              <p>{post.data.description}</p>
              {categories.length > 0 && (
                <div class="taxonomy taxonomy--compact">
                  {categories.map((category) => (
                    <a
                      class="chip"
                      href={`${base}categories/${toUrlSlug(category)}/`}
                    >
                      {category}
                    </a>
                  ))}
                </div>
              )}
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="section-block">
    <div class="section-head">
      <div>
        <p class="eyebrow">实验室精选</p>
        <h2>可以直接点开使用的界面项目</h2>
      </div>
      <a class="section-link" href={`${base}vibe/`}>
        查看全部项目 →
      </a>
    </div>

    <div class="app-grid">
      {LAB_APPS.map((app) => (
        <LabAppCard app={app} />
      ))}
    </div>
  </section>
</BaseLayout>
